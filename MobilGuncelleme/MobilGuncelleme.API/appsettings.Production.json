{
  "ConnectionStrings": {
    // PostgreSQL ve IIS aynı sunucuda. Anahtar adı bilerek modüle özel: makine seviyesindeki
    // ConnectionStrings__* değişkenleri "Postgres" gibi ortak adları ezer.
    // IIS sitesinde ConnectionStrings__MobilGuncellemePostgres ortam değişkeni tanımlanırsa bu değeri ezer.
    "MobilGuncellemePostgres": "Host=localhost;Port=5432;Database=mobil_guncelleme;Username=mobil_guncelleme_app;Password=!MobilGuncellemeM@tliOtomasyon!"
  },
  "MobilGuncelleme": {
    "ApkKlasoru": "E:\\MatliOtomasyon\\MobilSurumler",
    // "Mobil Sürüm Yönetimi" sayfasının Angular route'u = SharedApp'teki ModulLink + FormLink.
    // Frontend'deki route ve SharedApp'teki form tanımı bununla birebir aynı olmalı.
    "FormLink": "/yonetim/mobil-surum-yonetimi"
  },
  "TokenOption": {
    "Audience": [ "www.authserver.com", "www.miniapi1.com", "miniapi2.com", "www.miniapi3.com" ],
    "Issuer": "www.authserver.com",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 180,
    "SecurityKey": "mysecuritykeymysecuritykeymysecuritykeymysecuritykey"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
